# 로컬 PostgreSQL (샘플 생성·초기 이관용)
LOCAL_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/dbname

# Neon PostgreSQL (운영)
DATABASE_URL=postgresql+psycopg://neondb_owner:비밀번호@ep-xxx.ap-northeast-2.aws.neon.tech/neondb?sslmode=require
DEV_DATABASE_URL=postgresql+psycopg://neondb_owner:비밀번호@ep-yyy.ap-northeast-2.aws.neon.tech/neondb?sslmode=require

# Slack 알람 수신 주소 (Incoming Webhook)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# 재생 시작일 오프셋 (0 = 기본값 사용)
REPLAY_OFFSET_DAYS=0